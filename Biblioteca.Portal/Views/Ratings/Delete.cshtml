@model RatingFormViewModel
@{ ViewData["Title"] = "Șterge evaluarea"; }

<h1>Șterge evaluarea</h1>
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }
<div class="alert alert-warning">Confirmați ștergerea evaluării pentru <strong>@Model.Title</strong>, nota @Model.Stars.</div>
<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="ReaderId" type="hidden" />
    <input asp-for="BookId" type="hidden" />
    <input asp-for="Title" type="hidden" />
    <input asp-for="Stars" type="hidden" />
    <button class="btn btn-danger" type="submit">Șterge</button>
    <a asp-action="Index" asp-route-readerId="@Model.ReaderId" class="btn btn-secondary">Anulează</a>
</form>
