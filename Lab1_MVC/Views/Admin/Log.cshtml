@model Lab1_MVC.Models.PaginatedList<Lab1_MVC.Models.RecommendationLog>

@{
    ViewData["Title"] = "Jurnal recomandări";
}

<h1>Jurnal recomandări</h1>
<p><a asp-action="Index">&larr; Administrare</a></p>

@* Formularul nu trimite pageNumber: schimbarea filtrului resetează pagina la 1.
   sortOrder se păstrează printr-un câmp ascuns. *@
<form asp-action="Log" method="get" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
    <div class="col-auto">
        <label class="form-label" for="readerId">Cititor (ReaderId)</label>
        <input type="number" id="readerId" name="readerId" value="@ViewData["ReaderId"]" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="from">De la</label>
        <input type="date" id="from" name="from" value="@ViewData["From"]" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="to">Până la</label>
        <input type="date" id="to" name="to" value="@ViewData["To"]" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filtrează</button>
        <a asp-action="Log" class="btn btn-link">Resetează</a>
    </div>
</form>

<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Cititor</th>
            <th><a asp-action="Log" asp-route-sortOrder="@ViewData["DateSortParm"]"
                   asp-route-readerId="@ViewData["ReaderId"]"
                   asp-route-from="@ViewData["From"]"
                   asp-route-to="@ViewData["To"]">Data (UTC) @(ViewData["CurrentSort"] as string == "date_asc" ? "▲" : "▼")</a></th>
            <th>Cărți recomandate (ID)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ID</td>
                <td>@item.ReaderId</td>
                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@item.BookIds</td>
            </tr>
        }
    </tbody>
</table>

@{
    var prevDisabled = Model.HasPreviousPage ? "" : "disabled";
    var nextDisabled = Model.HasNextPage ? "" : "disabled";
}
<a asp-action="Log" asp-route-sortOrder="@ViewData["CurrentSort"]"
   asp-route-pageNumber="@(Model.PageIndex - 1)"
   asp-route-readerId="@ViewData["ReaderId"]"
   asp-route-from="@ViewData["From"]"
   asp-route-to="@ViewData["To"]"
   class="btn btn-outline-secondary @prevDisabled">Înapoi</a>
<a asp-action="Log" asp-route-sortOrder="@ViewData["CurrentSort"]"
   asp-route-pageNumber="@(Model.PageIndex + 1)"
   asp-route-readerId="@ViewData["ReaderId"]"
   asp-route-from="@ViewData["From"]"
   asp-route-to="@ViewData["To"]"
   class="btn btn-outline-secondary @nextDisabled">Înainte</a>
<span class="ms-2">Pagina @Model.PageIndex din @Math.Max(Model.TotalPages, 1)</span>
